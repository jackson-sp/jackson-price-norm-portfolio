{
  "headers": [
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|webp|svg|gif|ico|pdf))",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
