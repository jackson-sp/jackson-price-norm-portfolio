{
  "routes": [
    {
      "src": "/(.*\\.pdf)",
      "headers": {
        "Content-Type": "application/pdf",
        "Accept-Ranges": "bytes"
      },
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.(png|jpg|jpeg|webp|svg|gif|ico))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
